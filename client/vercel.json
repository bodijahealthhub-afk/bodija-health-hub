{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://backend-production-f347f.up.railway.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://backend-production-f347f.up.railway.app/uploads/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
