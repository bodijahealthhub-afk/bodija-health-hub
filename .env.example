# Bodija Health Hub — backend configuration
# Copy to .env and adjust. The API server loads this file on start.

# JWT signing secret. Use a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_to_a_long_random_secret

# Port the Express API listens on.
# MUST match the Vite dev proxy target in client/vite.config.js (default http://localhost:5000).
PORT=5000

# SQLite database file (relative to the project root).
DB_PATH=./data/database.sqlite

# Optional: connect to Postgres instead of SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Admin bootstrap credentials (only used on first seed).
# ADMIN_EMAIL=admin@bodijahealthhub.com
# ADMIN_PASSWORD=change_me

# CORS allowed browser origins (comma separated).
# CORS_ORIGINS=https://your-domain.com,http://localhost:5173
