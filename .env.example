# Bodija Health Hub — backend configuration
# Copy to .env and adjust. The API server loads this file on start.

# JWT signing secret — CRITICAL for production security.
# Generate a strong secret: openssl rand -hex 64
# The application WILL NOT START in production without this.
# Do NOT use short or guessable values.
JWT_SECRET=change_me_to_a_strong_random_secret_min_64_chars

# Port the Express API listens on.
# MUST match the Vite dev proxy target in client/vite.config.js (default http://localhost:5000).
PORT=5000

# SQLite database file (relative to the project root).
DB_PATH=./data/database.sqlite

# Optional: connect to Postgres instead of SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Admin bootstrap credentials (only used on first seed).
# REQUIRED on hosted deploys (Railway/Postgres) — the server fails fast without them.
# ADMIN_EMAIL=admin@bodijahealthhub.com
# ADMIN_PASSWORD=change_me

# Recipient of admin alert emails (new messages, new bookings).
ADMIN_EMAIL=admin@bodijahealthhub.com

# SMTP — enables email notifications (booking received/confirmed, new admin alerts).
# Leave unset to disable email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp_user
# SMTP_PASS=smtp_password
# SMTP_FROM="Bodija Health Hub <noreply@yourdomain.com>"

# CORS allowed browser origins (comma separated).
# CORS_ORIGINS=https://client-six-eta-66.vercel.app,https://client-nt8gk3ac6-team-bhh.vercel.app,http://localhost:5173

# Error tracking (optional).
# SENTRY_DSN=https://...

# Automated backups (default: nightly 3am UTC, keep 14).
# AUTO_BACKUP_ENABLED=true
# BACKUP_CRON=0 3 * * *
# BACKUP_RETENTION=14
# S3 object storage for offsite backup copies (optional).
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
